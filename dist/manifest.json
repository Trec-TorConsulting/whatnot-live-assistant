{
  "manifest_version": 3,
  "name": "Whatnot Assistant",
  "version": "0.20.3",
  "description": "Follow and bookmark the current show, auto sharing, collectible appraisal, live show stats, a max-bid guard, purchase tracking, and alerts for Whatnot.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.whatnot.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.gold-api.com/*",
    "https://api.pcgs.com/*",
    "https://api.scryfall.com/*",
    "https://api.pokemontcg.io/*",
    "https://db.ygoprodeck.com/*",
    "https://api.psacard.com/*",
    "https://api.discogs.com/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "optional_host_permissions": [
    "http://*:*/*",
    "https://*:*/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Whatnot Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "commands": {
    "toggle-share": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Start or stop Auto Share on this show"
    },
    "appraise": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Appraise the item on screen"
    },
    "toggle-assistant": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Show or hide the assistant panel on the page"
    }
  },
  "content_scripts": [
    {
      "js": [
        "src/page/hook.iife.js"
      ],
      "matches": [
        "https://*.whatnot.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "assets/index.ts-loader-Pd7cXMOY.js"
      ],
      "matches": [
        "https://*.whatnot.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.whatnot.com/*"
      ],
      "resources": [
        "assets/shop-MVf0g_2W.js",
        "assets/wheel-CC8ZZL-q.js",
        "assets/src-content-index.ts-DIJwW5Mn.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
